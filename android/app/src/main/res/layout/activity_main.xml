<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.gaterace.app.ui.GateOverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/hudTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:text="GateRace" />

        <TextView
            android:id="@+id/hudConn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#93C5FD"
            android:textSize="12sp"
            android:text="…" />

        <TextView
            android:id="@+id/hudTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4ADE80"
            android:textSize="26sp"
            android:text="—" />

        <TextView
            android:id="@+id/hudErr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F87171"
            android:textSize="11sp"
            android:maxLines="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/editUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="race box URL"
                android:inputType="textUri"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="12sp"
                android:background="#33000000"
                android:padding="6dp" />
            <EditText
                android:id="@+id/editPilot"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:hint="pilot"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="12sp"
                android:background="#33000000"
                android:padding="6dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button android:id="@+id/btnArm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Arm" />
        <Button android:id="@+id/btnSimBoost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Throttle+" android:layout_marginStart="8dp"/>
        <Button android:id="@+id/btnReconnect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reconnect" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/hudHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="12dp"
        android:paddingBottom="56dp"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:text="SIM — Layer-1. Emulator: http://10.0.2.2:8088 · Phone: http://&lt;laptop-lan-ip&gt;:8088" />
</FrameLayout>
